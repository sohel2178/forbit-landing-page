# ---------------------------------------------------------------------------
# FORBIT LIMITED website configuration.
# Copy to .env.local and edit. NEXT_PUBLIC_* values are inlined at BUILD time,
# so run `npm run build` again after changing them.
# Leave a value empty to use the default shown in brackets.
# ---------------------------------------------------------------------------

# Public production URL (canonical URLs, sitemap, robots, Open Graph).
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# --- Contact details --------------------------------------------------------
# [admin@forbit.tech]
NEXT_PUBLIC_CONTACT_EMAIL=
# Shown as written; the call link is converted to +880… automatically. [01409962090]
NEXT_PUBLIC_CONTACT_PHONE=
# Street address in English, and optionally in Bangla. [not shown → "Bangladesh"]
NEXT_PUBLIC_CONTACT_ADDRESS=
NEXT_PUBLIC_CONTACT_ADDRESS_BN=
# Google Maps link for the address card. [none]
NEXT_PUBLIC_CONTACT_MAP_URL=
# Business hours, e.g. "Sat–Thu, 10:00–19:00" / "শনি–বৃহস্পতি, সকাল ১০টা–সন্ধ্যা ৭টা". [not shown]
NEXT_PUBLIC_BUSINESS_HOURS=
NEXT_PUBLIC_BUSINESS_HOURS_BN=

# --- Social profiles (hidden as "soon" until set) ---------------------------
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# --- Products ---------------------------------------------------------------
# Official Tiktiki GPS Tracker website. Empty → "website coming soon".
NEXT_PUBLIC_TIKTIKI_URL=

# --- Contact form delivery (server-side, read at request time) --------------
# Any HTTPS endpoint accepting a JSON POST (email service, CRM, Slack/Zapier/
# Make webhook…). If unset, the form says honestly that nothing was sent.
CONTACT_WEBHOOK_URL=
